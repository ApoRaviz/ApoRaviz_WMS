{
  "name": "aporaviz-wms-backend",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "overrides": {
    "multer": "2.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/main.js",
    "dev": "tsx --env-file=../.env src/main.ts",
    "test": "node --env-file=../.env ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
